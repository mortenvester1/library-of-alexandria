# Derived from the upstream v1.4.2 variables.env, trimmed to what a LAN
# deployment actually sets. Every `:?`-guarded value below must be filled in.

# ---------------------------------------------------------------------------
# LAN addressing
# ---------------------------------------------------------------------------
# Bare host only — no scheme, no trailing slash, and lowercase. WEB_URL and
# CORS_ALLOWED_ORIGINS below prepend http:// themselves, and Django compares
# CORS_ALLOWED_ORIGINS byte-for-byte against an Origin header the browser has
# already lowercased. A LAN IP (192.168.x.y), or the avahi/mDNS name if the host
# advertises one (e.g. bibliotheca.local).
APP_DOMAIN=

# Host port for the Plane proxy. 80 is free across this repo's stacks; if you
# change it, the port must also appear in WEB_URL and CORS_ALLOWED_ORIGINS.
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# Include the port unless LISTEN_HTTP_PORT is 80.
WEB_URL=http://${APP_DOMAIN}
CORS_ALLOWED_ORIGINS=http://${APP_DOMAIN}

# Caddy's in-container listener, not the host port. Leave at :80 for plain HTTP.
SITE_ADDRESS=:80
CERT_EMAIL=
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_ACME_DNS=

# ---------------------------------------------------------------------------
# Versions — pinned so upgrades are deliberate
# ---------------------------------------------------------------------------
APP_RELEASE=v1.4.2
MCP_RELEASE=v0.3.2

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Generate every value with `openssl rand -hex 32`. Hex keeps them alphanumeric,
# which matters for the two that get embedded in URLs below — a literal
# @ : / # ? % there silently truncates the connection string.

# Derives the Fernet key for instance config (SMTP creds, OAuth secrets entered
# in god-mode). Rotating it makes those undecryptable, and decrypt_data swallows
# the error and returns "" — so the breakage is silent. Treat as permanent.
SECRET_KEY=

# Shared between api and live; one value, so it cannot drift.
LIVE_SERVER_SECRET_KEY=

# Applied only on first boot, while the pgdata / rabbitmq_data volumes are empty.
# Changing either later updates the URL but not the server-side user, and every
# connection starts failing auth.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=

# MinIO root credentials, also used as the S3 access key pair. MinIO rejects an
# access key under 3 chars or a secret under 8. Re-read from env on every start,
# so these are the only two here that can be rotated in place.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Built from the passwords above; compose does not derive them for you.
DATABASE_URL=postgresql://plane:${POSTGRES_PASSWORD}@plane-db/plane
AMQP_URL=amqp://plane:${RABBITMQ_PASSWORD}@plane-mq:5672/plane

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
MCP_HTTP_PORT=8211

# OAuth issuer, NOT the address clients connect to (that is
# http://${APP_DOMAIN}:${MCP_HTTP_PORT}/http/api-key/mcp). The MCP SDK rejects a
# non-HTTPS issuer at startup and exempts only loopback hosts, so leave this on
# localhost until the server sits behind real public HTTPS.
MCP_OAUTH_BASE_URL=http://localhost:${MCP_HTTP_PORT}

# The MCP process refuses to start on empty values, so these carry placeholders
# on the PAT path. Replace with real credentials only if you front the MCP
# server with public HTTPS and register an OAuth app under
# /<workspace>/settings/integrations/.
PLANE_OAUTH_PROVIDER_CLIENT_ID=unused-on-lan
PLANE_OAUTH_PROVIDER_CLIENT_SECRET=unused-on-lan

# ---------------------------------------------------------------------------
# Rarely changed
# ---------------------------------------------------------------------------
DEBUG=0
USE_MINIO=1
FILE_SIZE_LIMIT=5242880
API_KEY_RATE_LIMIT=60/minute
MINIO_ENDPOINT_SSL=0
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
