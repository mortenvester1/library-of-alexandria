# Absolute host path for uploaded originals. Must exist before first start.
UPLOAD_LOCATION=

# Absolute host path for the Postgres data directory. Keep it on a local
# POSIX filesystem — Immich's Postgres will not run on an SMB/NFS share.
DB_DATA_LOCATION=

DB_USERNAME=immich
DB_DATABASE_NAME=immich
DB_PASSWORD=

# Pin a release tag to make upgrades deliberate.
IMMICH_VERSION=release
