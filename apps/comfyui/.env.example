# Numeric GIDs from the CachyOS host:
#   getent group video  | cut -d: -f3
#   getent group render | cut -d: -f3
VIDEO_GID=
RENDER_GID=

# Shared with apps/upscaler. Mounted whole here (ComfyUI expects its own
# subdirectory layout: checkpoints/, upscale_models/, loras/, ...); the upscaler
# mounts only ${MODELS_DIR}/upscale_models, read-only.
MODELS_DIR=

# ComfyUI-only state: input/, output/, workflows/, and the hub caches.
COMFYUI_STORAGE=

COMFYUI_PORT=8188

# Leave commented out. Only needed when the container's ROCm predates gfx1201 support.
# Check with: docker compose run --rm --entrypoint rocminfo comfyui | grep gfx
# HSA_OVERRIDE_GFX_VERSION=

# 16 GB fits SDXL without --lowvram. Add "--reserve-vram 2" when the upscaler
# stack is running too: auto mode stacks the reservation on VRAM already held.
COMFYUI_CLI_ARGS=
