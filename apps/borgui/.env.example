# PUID: the account that owns the borg repos and the dump staging dir (`id -u`).
# PGID: the gid of the `storage` group, NOT your primary group —
# setup-permissions.sh prints it, and check-permissions.sh warns if they differ.
PUID=
PGID=

TZ=America/New_York
BORGUI_PORT=8081

# First-run admin password. Upstream defaults this to `admin123`; the compose
# file guards it so the stack refuses to start unset. Change it in the UI after
# the first login and this value stops mattering.
INITIAL_ADMIN_PASSWORD=

# Backup sources, read-only inside the container at /local/storage.
# Expected layout: immich/, couchdb/, seafile/, plus the media library.
STORAGE_PATH=/mnt/storage

# Borg UI's own state: sqlite db, script library, SSH keys, repo config, and the
# generated .secret_key that unlocks the stored repo passphrases. Back this up
# OUT OF BAND — it cannot live inside a repo Borg UI manages.
BORGUI_DATA_PATH=/mnt/storage/borgui-data

# Staging dir the pre-backup hooks dump databases into, at /local/dumps.
# Deliberately on the source drive, not the backup drive.
DUMPS_PATH=/mnt/storage/dumps

# The btrfs subvolume holding the borg repos, at /local/backup.
# Must be excluded from every backup source, along with /mnt/backup/@timemachine.
BORG_REPO_PATH=/mnt/backup/@borg

# Pin a tag to make upgrades deliberate. Defaults live in docker-compose.yaml.
# BORGUI_IMAGE=
# BORGUI_REDIS_IMAGE=
