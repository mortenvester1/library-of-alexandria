# Becomes the `instance` label on every metric and log line.
AGENT_HOSTNAME=

# Containers cannot resolve mDNS .local names; map the monitoring host by IP.
#   getent ahostsv4 <monitoring-host>.local | head -1
MONITORING_HOST_IP=

# Numeric GIDs from the host:
#   getent group video  | cut -d: -f3
#   getent group render | cut -d: -f3
VIDEO_GID=
RENDER_GID=
