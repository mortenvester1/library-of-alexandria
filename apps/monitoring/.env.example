# Grafana service account token, from
# Administration -> Users and access -> Service accounts.
# Needs permission for whichever MCP tools you intend to use.
GRAFANA_MCP_SVC_ACC_TOKEN=

# Bearer token MCP clients must send as `Authorization: Bearer <token>`.
# You choose this value yourself.
MCP_GRAFANA_SERVER_TOKEN=

# Host:port values clients may send in the Host header; anything else gets 403
# "host not allowed". Behind tailscale serve: <machine>.<tailnet>.ts.net:<https port>.
GRAFANA_MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
