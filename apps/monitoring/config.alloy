logging {
  level = "info"
  format = "json"
}

// ###############################
// #### Metrics Configuration ####
// ###############################

// Configure a prometheus.remote_write component to send metrics to a Prometheus server.
prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Host metrics
prometheus.exporter.unix "orinnano" {
  set_collectors = ["cpu", "disk", "filesystem", "meminfo", "nvme"]
}

// Configure a prometheus.scrape component to collect unix metrics.
prometheus.scrape "orinnano" {
  targets         = prometheus.exporter.unix.orinnano.targets
  forward_to      = [prometheus.remote_write.local.receiver]
  scrape_interval = "10s"
}

// Host Cadvisor on the Docker socket to expose container metrics.
prometheus.exporter.cadvisor "cadvisor" {
  docker_only = true
}

discovery.relabel "cadvisor" {
    targets = prometheus.exporter.cadvisor.cadvisor.targets

    rule {
        target_label = "job"
        replacement  = "integrations/docker"
    }

    rule {
        target_label = "instance"
        replacement  = constants.hostname
    }
}

// Configure a prometheus.scrape component to collect cadvisor metrics.
prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.cadvisor.output
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
}

// Scrape Immich metrics
prometheus.scrape "immich" {
  targets         = [{__address__ = "immich-server:8081"}, {__address__ = "immich-server:8082"}]
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
  metrics_path    = "/metrics"
}

// Scrape jellyfin metrics
prometheus.scrape "jellyfin" {
  targets         = [{__address__ = "jellyfin:8096"}]
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
  metrics_path    = "/metrics"
}

// Scrape Buzz relay metrics (relay joins the monitoring network as buzz-relay)
prometheus.scrape "buzz" {
  targets         = [{__address__ = "buzz-relay:9102"}]
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
  metrics_path    = "/metrics"
}

// Scrape Plane's broker and object store (both join the monitoring network by
// alias). The Plane app containers expose no /metrics — their logs and
// container metrics already arrive over the Docker socket.
prometheus.scrape "plane_mq" {
  targets         = [{__address__ = "plane-mq:15692"}]
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
  metrics_path    = "/metrics"
}

prometheus.scrape "plane_minio" {
  targets         = [{__address__ = "plane-minio:9000"}]
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
  metrics_path    = "/minio/v2/metrics/cluster"
}

// Scrape CouchDB. 17986 is the unauthenticated metrics-only listener enabled by
// apps/couchdb/10-metrics.ini; it exists on the Docker network only. The same
// data is on 5984 behind admin basic auth, which we deliberately avoid needing.
prometheus.scrape "couchdb" {
  targets         = [{__address__ = "couchdb:17986"}]
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
  metrics_path    = "/_node/_local/_prometheus"
}

// Scrape Seahub. Dark until ENABLE_METRIC / METRIC_AUTH_USER / METRIC_AUTH_PWD
// are set in seahub_settings.py inside the Seafile data volume — that file does
// not exist until after Seafile's first start, so it cannot be set from compose.
// Unset credentials degrade to up=0 on this job alone.
prometheus.scrape "seafile" {
  targets         = [{__address__ = "seafile:80"}]
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
  metrics_path    = "/metrics"

  basic_auth {
    username = sys.env("SEAFILE_METRIC_USER")
    password = sys.env("SEAFILE_METRIC_PWD")
  }
}

// Scrape TimeNest's web UI. Port 8080 is the container port, not the published
// one — apps/timenest publishes 8083 on the host. /metrics carries no auth
// dependency upstream, so it is also reachable on that host port; it exposes
// per-user backup sizes and timestamps, nothing secret. Dark when
// ENABLE_METRICS=false in apps/timenest/.env, which degrades to up=0 here only.
prometheus.scrape "timenest" {
  targets         = [{__address__ = "timenest:8080"}]
  forward_to      = [ prometheus.remote_write.local.receiver ]
  scrape_interval = "10s"
  metrics_path    = "/metrics"
}

// ###############################
// #### Logging Configuration ####
// ###############################

// Discover Docker containers and extract metadata.
discovery.docker "linux" {
  host = "unix:///var/run/docker.sock"
}

// Define a relabeling rule to create a service name from the container name.
discovery.relabel "logs_integrations_docker" {
      targets = []

      rule {
          source_labels = ["__meta_docker_container_name"]
          regex = "/(.*)"
          target_label = "container_name"
      }

     rule {
        target_label = "instance"
        replacement  = constants.hostname
    }

  }


// Configure a loki.source.docker component to collect logs from Docker containers.
loki.source.docker "default" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.linux.targets
  relabel_rules = discovery.relabel.logs_integrations_docker.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
