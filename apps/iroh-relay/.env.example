# ---------------------------------------------------------------------------
# Version — pinned so upgrades are deliberate
# ---------------------------------------------------------------------------
# Match the iroh-relay crate in reason-network's Cargo.lock; amd64 + arm64.
IROH_RELAY_IMAGE=n0computer/iroh-relay:v1.3.0

# ---------------------------------------------------------------------------
# Listener
# ---------------------------------------------------------------------------
# Host port on 127.0.0.1 only; 3340 is free across this repo's stacks. If you
# change it, change the local port in scripts/tailscale-serve-port-map to match.
IROH_RELAY_PORT=3340

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# TLS: scripts/tailscale-serve.sh serves it on https port 4410, tailnet only,
# from the line `4410 3340 iroh-relay` in the gitignored
# scripts/tailscale-serve-port-map.
#
# Single point of failure: once a team sets this relay, its machines never use
# n0's relays or DNS. With the relay down, only machines on the same physical
# LAN (mDNS) still find each other.
#
# Metrics: on 9090 inside the container, unpublished and not scraped.
