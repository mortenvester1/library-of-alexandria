# Numeric GIDs from the CachyOS host:
#   getent group video  | cut -d: -f3
#   getent group render | cut -d: -f3
VIDEO_GID=
RENDER_GID=

# Host directory holding the shared model tree. The upscaler mounts
# ${MODELS_DIR}/upscale_models read-only; ComfyUI mounts ${MODELS_DIR} whole.
MODELS_DIR=

UPSCALER_PORT=8700

# Leave commented out. Only needed when the wheel's ROCm predates gfx1201 support.
# Check the arch torch actually sees with: just gfx
# HSA_OVERRIDE_GFX_VERSION=
PYTORCH_ROCM_ARCH=gfx1201

# Lower UPSCALER_TILE if requests return 507.
UPSCALER_TILE=512
UPSCALER_TILE_OVERLAP=32
UPSCALER_BLEED_PASSES=16

# box   = nearest, preserves the hard 1-bit silhouette
# model = runs the mask through the upscale model; may ring at edges
UPSCALER_ALPHA_SCALE=box

UPSCALER_LOG_LEVEL=INFO
