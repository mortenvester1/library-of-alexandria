# Derived from https://manual.seafile.com/13.0/repo/docker/ce/env, trimmed to a
# LAN deployment. Upstream's COMPOSE_FILE / COMPOSE_PATH_SEPARATOR are dropped
# on purpose — this stack is a single docker-compose.yaml.
# Every `:?`-guarded value below must be filled in.

# ---------------------------------------------------------------------------
# LAN addressing
# ---------------------------------------------------------------------------
# Bare host only — no scheme, no port, no trailing slash. A LAN IP
# (192.168.x.y) or the avahi/mDNS name (e.g. bibliotheca.local).
SEAFILE_HOST=

# Host port. 8088 is free across this repo's stacks (apps/plane holds 80/443).
SEAFILE_HTTP_PORT=8088

# Seahub derives SERVICE_URL, FILE_SERVER_ROOT and the CSRF trusted origins from
# this. If the port is missing or wrong the login page still loads and *uploads*
# fail with opaque errors — so smoke-test by uploading a file, not by browsing.
# Drop the `:${SEAFILE_HTTP_PORT}` suffix only if you move this to port 80.
SEAFILE_SERVER_HOSTNAME=${SEAFILE_HOST}:${SEAFILE_HTTP_PORT}
SEAFILE_SERVER_PROTOCOL=http

TIME_ZONE=Europe/Copenhagen

# ---------------------------------------------------------------------------
# Versions — pinned so upgrades are deliberate
# ---------------------------------------------------------------------------
# seafile-mc 13.0.25 ships linux/amd64 + linux/arm64. Seafile only supports
# single-minor-version upgrade steps (13.0 -> 13.1), so do not jump minors.
SEAFILE_IMAGE=seafileltd/seafile-mc:13.0.25
SEAFILE_DB_IMAGE=mariadb:10.11
SEAFILE_REDIS_IMAGE=redis:7.4-alpine

# ---------------------------------------------------------------------------
# Persistent storage — absolute host paths, must exist before first start
# ---------------------------------------------------------------------------
# Library blobs live here and this is what grows; put it on the big disk.
SEAFILE_VOLUME=/mnt/storage/seafile/data

# Keep on a local POSIX filesystem — MariaDB will not run on an SMB/NFS share.
SEAFILE_MYSQL_VOLUME=/mnt/storage/seafile/mysql

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Generate every value with `openssl rand -hex 32`. Hex keeps them alphanumeric,
# which matters because a literal @ : / # ? % silently truncates a DB or Redis
# connection string. JWT_PRIVATE_KEY must be at least 32 characters.
JWT_PRIVATE_KEY=
SEAFILE_MYSQL_DB_PASSWORD=
REDIS_PASSWORD=

# Only read on first-time startup, when the seafile user and schemas are created.
INIT_SEAFILE_MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Initial admin — only read on first-time startup
# ---------------------------------------------------------------------------
# Change the password in the web UI afterwards; this value stays in .env.
INIT_SEAFILE_ADMIN_EMAIL=
INIT_SEAFILE_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# Upload size: the desktop/mobile sync clients chunk and are unaffected, but
# browser uploads are capped by `max_upload_size` in
# ${SEAFILE_VOLUME}/seafile/conf/seafile.conf ([fileserver] section), which does
# not exist until after the first start. Raise it there, then
# `docker compose restart seafile`.
#
# Metrics: Seahub serves /metrics on the same port as the web UI, but only once
# ENABLE_METRIC is on. It is read from seahub_settings.py, which like
# seafile.conf does not exist until after the first start, so it cannot be set
# from compose. Add to ${SEAFILE_VOLUME}/seafile/conf/seahub_settings.py:
#
#   ENABLE_METRIC = True
#   METRIC_AUTH_USER = "..."
#   METRIC_AUTH_PWD  = "..."
#
# then `docker compose restart seafile`. These are scrape-only credentials, not
# a Seafile account — pick fresh values. Put the same pair in apps/monitoring/.env
# as SEAFILE_METRIC_USER / SEAFILE_METRIC_PWD, which is where Alloy reads them.
# Until both sides are set the `seafile` scrape job simply reports up=0.
