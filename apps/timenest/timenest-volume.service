<?xml version="1.0" standalone='no'?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!--
  One Time Machine volume: SMB, model and Apple Disk records together, in a
  single service group whose <name> is the Samba share.

  Two things upstream gets wrong here, and they have to be fixed together:

    - macOS mounts smb://<host>/<service instance name>, not the adVN in the
      TXT record, so the group must be named after the SHARE. Naming it after
      the server makes a Mac authenticate and then fail the tree connect with
      NT_STATUS_BAD_NETWORK_NAME.
    - _adisk must sit in the SAME group as the _smb record it belongs to.
      Advertising the volume in its own group, with _smb left under the server's
      name, makes the disk disappear from Time Machine entirely.

  setup.sh renders one of these per fragment in <config>/shares.d.
-->

<service-group>

  <name replace-wildcards="yes">${SHARE_NAME}</name>

  <service>
    <type>_smb._tcp</type>
    <port>445</port>
  </service>

  <service>
    <type>_device-info._tcp</type>
    <port>0</port>
    <txt-record>model=${DEVICE_MODEL}</txt-record>
  </service>

  <service>
    <type>_adisk._tcp</type>
    <port>9</port>
    <txt-record>sys=waMa=0,adVF=0x100</txt-record>
    <txt-record>dk0=adVN=${SHARE_NAME},adVF=0x82</txt-record>
  </service>

</service-group>
