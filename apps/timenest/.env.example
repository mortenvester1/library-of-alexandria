# Every `:?`-guarded value below must be filled in.

# ---------------------------------------------------------------------------
# Versions — pinned by digest
# ---------------------------------------------------------------------------
# Upstream publishes no semver tags: ghcr.io/momenbasel/timenest-* carry only
# `main` and `latest`, both of which move. There is nothing to pin *to*, so
# these are manifest-list digests, resolved 2026-09-22 from `latest`.
# To bump: docker buildx imagetools inspect ghcr.io/momenbasel/timenest-web:latest
TIMENEST_SAMBA_IMAGE=ghcr.io/momenbasel/timenest-samba@sha256:4942e805a736c24f2092e29c293339c694898c7ecc4adf2da14d665889960af6
TIMENEST_WEB_IMAGE=ghcr.io/momenbasel/timenest-web@sha256:70de24c664c159790b10c2b1055560c5bddd8b98f48b683c67518e893db0a036

# The avahi image is not used — see the header in docker-compose.yaml. Kept
# here only so a future bump does not have to re-derive it.
# Pin only if the upstream default in docker-compose.yaml needs overriding.
# TIMENEST_SOCKET_PROXY_IMAGE=
#
# TIMENEST_AVAHI_IMAGE=ghcr.io/momenbasel/timenest-avahi@sha256:79c89d885583b213c75675646a309e962fa522d097bdf006cbcacd3f96fe094f

# ---------------------------------------------------------------------------
# Backup target
# ---------------------------------------------------------------------------
# The btrfs subvolume already created and `chattr +C`'d for this purpose in
# apps/borgui/README.md. NOT upstream's /mnt/timenest, and not under
# /mnt/storage — that drive is the Borg *source*, this one is the backup drive.
# It must stay excluded from every Borg source; apps/borgui/.env.example says so.
BACKUP_PATH=/mnt/backup/@timemachine

# ---------------------------------------------------------------------------
# State — absolute host paths
# ---------------------------------------------------------------------------
# Upstream writes these as `./data/samba`, `./data/web`, `./data/config`, i.e.
# relative to wherever compose was invoked from. Absolute paths remove the class
# of failure apps/jellyfin/.env.example documents at length.
#
# Deliberately on the source drive, not the backup drive: passdb.tdb is the one
# piece of this stack that is not regenerable, and it has to be backed up. Lose
# it and every Mac re-enrolls, which Time Machine treats as a fresh backup.
# setup.sh creates these 2775 <you>:storage so Borg UI, which mounts
# /mnt/storage read-only as PUID:PGID, can actually read them — see README.md.
TIMENEST_SAMBA_STATE=/mnt/storage/timenest/samba
TIMENEST_CONFIG_PATH=/mnt/storage/timenest/config
TIMENEST_WEB_DATA=/mnt/storage/timenest/web

# ---------------------------------------------------------------------------
# Identity — what the Macs see
# ---------------------------------------------------------------------------
# SERVER_NAME is the Bonjour name and the netbios name. Changing it after Macs
# have enrolled points them at a share that no longer exists.
SERVER_NAME=TimeNest
# Drives the Finder icon only. TimeCapsule8,119 = Time Capsule icon.
DEVICE_MODEL=TimeCapsule8,119

# ---------------------------------------------------------------------------
# Web UI
# ---------------------------------------------------------------------------
# Upstream defaults ADMIN_PASSWORD to `changeme-please`; the compose file guards
# it so the stack refuses to start unset.
ADMIN_USER=admin
ADMIN_PASSWORD=

# 8080 is taken (apps/open_webui publishes it, apps/buzz uses it internally),
# 8081 is borgui, 8082 is immich's commented-out block. 8083 is the lowest port
# claimed by nothing in this repo and listening on nothing on bee.
WEB_PORT=8083

# Per-user cap, applied as `fruit:time machine max size`. Without it one Mac
# fills the drive. Overridable per user in the UI.
DEFAULT_QUOTA_GB=500

# Prometheus /metrics on the web port, scraped over the `monitoring` network.
ENABLE_METRICS=true

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
TIMEZONE=America/New_York
LOG_LEVEL=INFO

# Interfaces Samba binds to, space-separated. Upstream leaves this empty, which
# binds everything — including tailscale0, i.e. the share would be reachable
# from every tailnet peer. Set it to this host's LAN NIC — `ip -o -4 addr` —
# and re-check after any NIC rename; `lo` is appended by the smb.conf template.
SMB_INTERFACES=enp2s0   # verify against `ip -o -4 addr` before first start

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# Ports: samba is host-networked and binds 445/tcp on the host; it is not
# remappable from here (macOS will not mount Time Machine on another port).
# Bonjour goes out over the HOST avahi-daemon on 5353/udp, which apps/entrance
# also depends on — this stack does not run its own. setup.sh installs
# /etc/avahi/services/timenest.service for it.
#
# Host smbd must be stopped and masked before starting this. It is currently
# inactive on this host; setup.sh checks.
