# Every `:?`-guarded value below must be filled in.

# ---------------------------------------------------------------------------
# Version — pinned so upgrades are deliberate
# ---------------------------------------------------------------------------
# 3.5.2.1 ships linux/amd64 + linux/arm64.
COUCHDB_IMAGE=couchdb:3.5.2.1

# ---------------------------------------------------------------------------
# Admin credentials
# ---------------------------------------------------------------------------
# Unlike seafile's INIT_* variables, these are re-read on EVERY start: the
# entrypoint rewrites the admin into the container's own docker.ini, which is not
# persisted. Changing them here changes the admin; losing them locks you out.
# Generate the password with `openssl rand -hex 32` — hex keeps it alphanumeric,
# and LiveSync embeds these credentials in a Setup URI.
COUCHDB_USER=
COUCHDB_PASSWORD=

# ---------------------------------------------------------------------------
# Listener
# ---------------------------------------------------------------------------
# 5984 is free across this repo's stacks.
COUCHDB_PORT=5984

# ---------------------------------------------------------------------------
# Persistent storage — absolute host path
# ---------------------------------------------------------------------------
# Must exist AND be owned by uid/gid 5984 before the first start, or the
# container exits immediately:
#   mkdir -p /mnt/storage/couchdb/data && sudo chown -R 5984:5984 /mnt/storage/couchdb/data
COUCHDB_DATA=/mnt/storage/couchdb/data

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# Mobile: Obsidian on iOS/Android refuses plain HTTP, so a phone cannot use
# http://<host>:5984 directly. Desktop on the LAN works as-is. Put this behind
# whatever ingress or tunnel already terminates TLS — apps/plane holds 80/443 —
# and proxy to the root path, not a subdirectory, or LiveSync reports
# "404 Database not found". Disable response buffering and raise the proxy body
# limit; see the Reverse Proxies section of the upstream setup doc.
#
# Node UUID: local.d is not persisted, so recreating the container regenerates
# the node UUID and invalidates replication checkpoints. Clients re-scan; no data
# is lost. Acceptable for a single-node personal sync remote.
