# Mirrors the Bash rules in ~/.claude/settings.json. "allow" runs a command outside the
# sandbox, so only commands that must leave it (network, remotes, cluster) are allowed;
# read-only shell tools already run inside the sandbox. "prompt" beats "allow".

prefix_rule(pattern = ["awk"], decision = "allow")
prefix_rule(pattern = ["command", "-v"], decision = "allow")
prefix_rule(pattern = ["echo"], decision = "allow")
prefix_rule(pattern = ["find"], decision = "allow")
prefix_rule(pattern = ["ps"], decision = "allow")
prefix_rule(pattern = ["pwd"], decision = "allow")
prefix_rule(pattern = ["source", ".venv/bin/activate"], decision = "allow")
prefix_rule(pattern = ["which"], decision = "allow")

prefix_rule(pattern = ["git", ["checkout", "diff", "fetch", "log", "pull", "push", "show", "status"]], decision = "allow")
prefix_rule(pattern = ["git", "push", ["--force", "--force-with-lease", "-f", "--delete"]], decision = "prompt", justification = "History rewrite or remote branch deletion. Add a new commit and plain push instead.")
prefix_rule(pattern = ["git", "push", "origin", ["--force", "--force-with-lease", "-f", "--delete"]], decision = "prompt", justification = "History rewrite or remote branch deletion. Add a new commit and plain push instead.")
prefix_rule(pattern = ["git", "commit", "--amend"], decision = "prompt", justification = "Never amend. Add a new commit.")
prefix_rule(pattern = ["git", "checkout", ["--", "."]], decision = "prompt", justification = "Discards working-tree changes.")
prefix_rule(pattern = ["git", "config", "--global"], decision = "prompt")

prefix_rule(pattern = ["gh", ["api", "pr", "search"]], decision = "allow")
prefix_rule(pattern = ["gh", "run", ["list", "view"]], decision = "allow")
prefix_rule(pattern = ["gh", "pr", ["merge", "close"]], decision = "prompt", justification = "Merging or closing a PR is the user's call.")
prefix_rule(pattern = ["gh", "api", ["-X", "--method"]], decision = "prompt", justification = "Non-GET API call.")

prefix_rule(pattern = ["uv", "sync"], decision = "allow")
prefix_rule(pattern = ["uv", "run", ["pytest", "ruff"]], decision = "allow")
prefix_rule(pattern = ["prek", "run"], decision = "allow")
prefix_rule(pattern = ["pre-commit", "run"], decision = "allow")
prefix_rule(pattern = ["cargo", ["build", "check", "clippy", "fmt", "test"]], decision = "allow")

prefix_rule(pattern = ["kubectl", ["get", "describe", "logs"]], decision = "allow")
prefix_rule(pattern = ["kubectl", "config", ["current-context", "get-contexts"]], decision = "allow")
prefix_rule(pattern = ["kubectl", "get", ["secret", "secrets"]], decision = "prompt", justification = "Secret values would land in the transcript.")
prefix_rule(pattern = ["flux", "get"], decision = "allow")
