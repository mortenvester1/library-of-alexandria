{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(awk *)",
      "Bash(command *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(gh search *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git status)",
      "Bash(git checkout main && git pull *)",
      "Bash(git fetch *)",
      "Bash(ps *)",
      "Bash(pwd)",
      "Bash(source .venv/bin/activate *)",
      "Bash(which *)",
      "Read(~/.config/**)",
      "Read(~/git/**)",
      "Skill",
      "WebSearch",
      "mcp__acp__Bash",
      "mcp__acp__Edit",
      "mcp__acp__Write"
    ],
    "deny": [
      "Edit(~/git/**/.env*)",
      "Read(~/git/**/.env*)"
    ],
    "ask": [
      "Edit(~/git/**/.env*)",
      "Read(~/git/**/.env*)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "advisorModel": "opus",
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "autoCompactEnabled": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
