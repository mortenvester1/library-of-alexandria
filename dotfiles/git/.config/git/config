[user]
    name = Morten Pedersen
[core]
    excludesfile = ~/.config/git/ignore
[alias]
    br = "!f() { git branch | fzf | xargs git checkout; }; f"
    camend = "!f() { git add . && git commit --amend --no-edit; }; f"
    co = checkout
    comp = "!f() { git checkout main || git checkout master && git pull --prune; }; f"
    empty = "!f() { git commit -m 'retrigger checks' --allow-empty; }; f"
    fco = "!f() { git fetch && git checkout $1; }; f"
    ftags = "!f() { git fetch --tags ; }; f";
    pushup = "!f() { git push -u origin HEAD; }; f"
    tco = "!f() { git branch | grep $1 | head -n 1 | xargs git checkout; }; f"
    typo = "!f() { git commit -am 'typo' && git push; }; f"
    status-br = "!git branch \
        --sort=authordate \
        --sort=upstream:track \
        --format '%(refname:short) %(color:bold blue)%(if)%(upstream)%(then)%(if)%(upstream:track)%(then)%(upstream:track)%(else)%(color:bold green)[synced]%(end)%(else)%(color:bold yellow)[local]%(end)%(color:reset) %(authordate:relative)'"
	clean-br = !git comp && git status-br | awk '$2 == \"[gone]\" { print $1 }' | xargs -r git branch -D
[url "ssh://git@github.com"]
	insteadOf = https://github.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[include]
    path = ~/.config/git/.gitlocal
