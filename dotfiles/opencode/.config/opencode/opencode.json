{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["{env:HOME}/.config/opencode/AGENTS.md", "{env:HOME}/.config/opencode/AGENTS.local.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "awk *": "allow",
      "basename *": "allow",
      "cat *": "allow",
      "command -v *": "allow",
      "cut *": "allow",
      "date": "allow",
      "date *": "allow",
      "diff *": "allow",
      "dirname *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "printf *": "allow",
      "ps": "allow",
      "ps *": "allow",
      "pwd": "allow",
      "readlink *": "allow",
      "realpath *": "allow",
      "rg *": "allow",
      "sed -n *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "tr *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "source .venv/bin/activate": "allow",
      "source .venv/bin/activate *": "allow",
      "git add *": "allow",
      "git blame *": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git branch -a *": "allow",
      "git check-ignore *": "allow",
      "git checkout *": "allow",
      "git commit *": "allow",
      "git config *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git fetch": "allow",
      "git fetch *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git pull": "allow",
      "git pull *": "allow",
      "git push": "allow",
      "git push *": "allow",
      "git remote -v": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git stash list": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git worktree list": "allow",
      "git worktree list *": "allow",
      "gh api *": "allow",
      "gh pr *": "allow",
      "gh run list": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh search *": "allow",
      ".venv/bin/python -m pytest": "allow",
