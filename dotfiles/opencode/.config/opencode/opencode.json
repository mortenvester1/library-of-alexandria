      ".venv/bin/pytest": "allow",
      ".venv/bin/pytest *": "allow",
      "pre-commit run": "allow",
      "pre-commit run *": "allow",
      "prek run": "allow",
      "prek run *": "allow",
      "pytest": "allow",
      "pytest *": "allow",
      "ruff check": "allow",
      "ruff check *": "allow",
      "ruff format --check": "allow",
      "ruff format --check *": "allow",
      "uv run pytest": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow",
      "uv sync": "allow",
      "uv sync *": "allow",
      "cargo build": "allow",
      "cargo build *": "allow",
      "cargo check": "allow",
      "cargo check *": "allow",
      "cargo clippy": "allow",
      "cargo clippy *": "allow",
      "cargo fmt": "allow",
      "cargo fmt *": "allow",
      "cargo test": "allow",
      "cargo test *": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "kubectl config current-context": "allow",
      "kubectl config get-contexts": "allow",
      "kubectl config get-contexts *": "allow",
      "flux get *": "allow",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "git push * --force*": "ask",
      "git push * -f *": "ask",
      "git push --delete *": "ask",
      "git commit --amend*": "ask",
      "git commit * --amend*": "ask",
      "git checkout -- *": "ask",
      "git checkout .": "ask",
      "git config --global *": "ask",
      "gh pr merge *": "ask",
      "gh pr close *": "ask",
      "gh api -X *": "ask",
      "gh api --method *": "ask",
      "gh api * -f *": "ask",
      "gh api * -F *": "ask",
      "gh api * --field *": "ask",
      "gh api * --raw-field *": "ask",
      "gh api * --input *": "ask",
      "kubectl get secret*": "ask",
      "kubectl get * secret*": "ask",
      "kubectl * get secret*": "ask",
      "kubectl * get * secret*": "ask",
      "kubectl delete *": "deny",
      "kubectl apply *": "deny",
      "kubectl patch *": "deny",
      "kubectl edit *": "deny",
      "flux suspend *": "deny",
      "flux resume *": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env.*": "ask",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.*.local": "deny",
      "~/.aws/*": "deny",
      "~/.config/aws/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.config/gnupg/*": "deny",
      "~/.config/rclone/rclone.conf": "deny",
      "~/.kube/config": "deny",
      "~/.orca/linear-tokens": "deny",
      "~/.ssh/*": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env.*": "ask",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.*.local": "deny"
    },
    "write": {
      "*": "allow",
      "**/.env.*": "ask",
      "**/.env": "deny",
      "**/.env.local": "deny",
      "**/.env.*.local": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "~/git/**": "allow",
      "~/.config/**": "allow",
      "~/orca/workspaces/**": "allow"
    }
  }
}
